# 小安智能健身 MCP 配置示例
# 复制为 .env 后填写。任何真实密钥都不得提交到 GitHub。
XIAOAN_STORE=feishu
# 默认仅本机监听；Docker Compose 会在容器内显式覆盖为 0.0.0.0。
HOST=127.0.0.1
PORT=3000
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
MCP_ALLOWED_ORIGINS=
MCP_MAX_BODY_BYTES=1048576
XIAOAN_DEFAULT_CHANNEL=个人 Agent

# 小安专用飞书自建应用（不要复用其他机器人的应用）
FEISHU_APP_ID=replace-with-dedicated-feishu-app-id
FEISHU_APP_SECRET=replace-with-secret-stored-only-on-server
FEISHU_BASE_TOKEN=IGcObGkCcaMoGRsbNb2cJ3KKnEe
FEISHU_TABLE_ID=tblm6yZvCk95yJmo
